{
	"compilerOptions": {
		"strict": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2022",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"types": ["node"],
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
